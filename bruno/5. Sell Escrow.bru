meta {
  name: 5. Sell Escrow
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/escrows/{{escrowId}}/sell
  body: json
  auth: none
}

body:json {
  {
    "requested_by": "acc_buyer_001",
    "settlement_notes": "Hardware passed inspection. Releasing $500.00 to seller account."
  }
}

docs {
  **Sell / Release Escrow**: Completes the sale by transferring funds directly from the Escrow Vault Account -> Seller Account on the Universal Ledger. Updates status to RELEASED.
}
