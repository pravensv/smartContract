meta {
  name: 4. Hold Escrow
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/escrows/{{escrowId}}/hold
  body: json
  auth: none
}

body:json {
  {
    "requested_by": "acc_buyer_001",
    "reason": "Inspection in progress. Testing hardware components and serial number."
  }
}

docs {
  **Hold Escrow**: Places escrow into a HELD state on the Universal Ledger during inspection or dispute freeze using contract method invocation (InvokeContractMethod). Prevents unilateral withdrawals.
}
